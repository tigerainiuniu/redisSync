[Unit]
Description=Redis Sync Service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=redis-sync
Group=redis-sync
WorkingDirectory=/opt/redis-sync
ExecStart=/opt/redis-sync/.venv/bin/python /opt/redis-sync/run_sync_service.py --config /etc/redis-sync/config.yaml
Restart=always
RestartSec=10
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal
LogsDirectory=redis-sync
PrivateTmp=true
UMask=0077
NoNewPrivileges=true

# 资源限制
LimitNOFILE=65536
MemoryMax=4G

[Install]
WantedBy=multi-user.target
